# Server port (defaults to 3000)
PORT="3000"

# FawryPay Gateway (Server-side secrets ONLY — never expose to client)
# Configure via Secrets / Environment Variables to enable Fawry LIVE mode.
FAWRY_MERCHANT_CODE=""
FAWRY_SECURITY_KEY=""

# Optional HMAC signing key for server-side sandbox & webhook verification
SANDBOX_HMAC_SECRET=""

# Server session signing key (if omitted, an ephemeral CSPRNG secret is generated at boot)
SESSION_SECRET=""

# Independent Owner security setup secret (required if bootstrapping Owner PIN without active Google session)
OWNER_SETUP_SECRET=""

# Email OTP Delivery Transport (Primary: Gmail SMTP App Password — no dummy keys)
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
OTP_FROM_EMAIL=""

# Optional variables (NOT required to run the system or send OTP)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Independent Executive Governance Initial Passwords (Optional bootstrap via environment)
# Never hardcode passwords in source files; users claim or rotate them securely.
ADMIN_HAMZA_INITIAL_PASSWORD=""
ADMIN_ADLY_INITIAL_PASSWORD=""
ADMIN_WAHID_INITIAL_PASSWORD=""

